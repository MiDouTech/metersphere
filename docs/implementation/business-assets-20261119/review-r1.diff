+    String id = connect();
+    jdbc.update("UPDATE business_asset SET current_version_id='v2'");
+    jdbc.update("INSERT INTO business_asset_version(id,snapshot_json) VALUES('v2','changed')");
+    assertEquals("v1", service.context("p", id).getFirst().get("versionId"));
