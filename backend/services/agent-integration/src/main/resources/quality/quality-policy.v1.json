{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "rules"],
  "properties": {
    "schemaVersion": {"enum": ["quality-policy.v1"]},
    "name": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S"},
    "rules": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false,
            "required": ["ruleId", "parameters"],
            "properties": {
              "ruleId": {"enum": ["Q-EVIDENCE-01"]},
              "parameters": {
                "type": "object", "additionalProperties": false,
                "required": ["requiredRoles", "allowedMimeTypes", "maxArtifactBytes"],
                "properties": {
                  "requiredRoles": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["BEFORE_ACTION", "AFTER_ACTION"]}},
                  "allowedMimeTypes": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["image/png", "image/jpeg"]}},
                  "maxArtifactBytes": {"type": "integer", "minimum": 1, "maximum": 10485760}
                }
              }
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["ruleId", "parameters"],
            "properties": {
              "ruleId": {"enum": ["Q-ASSERT-01"]},
              "parameters": {
                "type": "object", "additionalProperties": false,
                "required": ["allowedOperators", "expectedSource"],
                "properties": {
                  "allowedOperators": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["EQUALS", "IN_RANGE"]}},
                  "expectedSource": {"enum": ["FROZEN_CONTRACT"]}
                }
              }
            }
          }
        ]
      }
    }
  }
}
