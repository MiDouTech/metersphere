{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metersphere.io/schema/ai/execution-contract-v1.schema.json",
  "title": "MeterSphere AI Execution Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "taskId", "snapshotHash", "scope", "environmentProfileVersion", "credentialRole", "runnerRequirements", "cases", "generatedAt"],
  "properties": {
    "contractVersion": { "const": "v1" },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "snapshotHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scope": { "type": "object", "additionalProperties": false, "required": ["caseIds", "addedCaseIds"], "properties": {
      "caseIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
      "addedCaseIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }
    } },
    "environmentProfileVersion": { "type": "integer", "minimum": 1 },
    "credentialRole": { "type": "string", "minLength": 1, "maxLength": 128 },
    "runnerRequirements": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } },
    "generatedAt": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "case": { "type": "object", "additionalProperties": false, "required": ["caseId", "assetVersionId", "name", "steps", "cleanupActions"], "properties": {
      "caseId": { "type": "string", "minLength": 1, "maxLength": 64 }, "assetVersionId": { "type": "string", "minLength": 1, "maxLength": 64 },
      "name": { "type": "string", "minLength": 1, "maxLength": 1000 }, "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
      "cleanupActions": { "type": "array", "items": { "$ref": "#/$defs/action" } }
    } },
    "step": { "type": "object", "additionalProperties": false, "required": ["stepId", "action", "assertions", "onFailure", "evidencePolicy"], "properties": {
      "stepId": { "type": "string", "minLength": 1, "maxLength": 64 }, "action": { "$ref": "#/$defs/action" },
      "assertions": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/assertion" } },
      "onFailure": { "type": "string", "enum": ["STOP_CASE", "CONTINUE_CASE", "STOP_TASK", "NEEDS_REVIEW"] },
      "evidencePolicy": { "type": "string", "enum": ["ON_FAILURE", "ALWAYS", "NONE"] }
    } },
    "locator": { "type": "object", "additionalProperties": false, "required": ["strategy"], "properties": {
      "strategy": { "type": "string", "enum": ["TEST_ID", "ROLE", "LABEL", "PLACEHOLDER", "TEXT", "CSS"] },
      "testId": { "type": "string", "minLength": 1, "maxLength": 500 }, "role": { "type": "string", "minLength": 1, "maxLength": 100 },
      "name": { "type": "string", "minLength": 1, "maxLength": 500 }, "label": { "type": "string", "minLength": 1, "maxLength": 500 },
      "placeholder": { "type": "string", "minLength": 1, "maxLength": 500 }, "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
      "selector": { "type": "string", "minLength": 1, "maxLength": 1000 }
    } },
    "action": { "type": "object", "additionalProperties": false, "required": ["contractVersion", "id", "type", "timeoutMs", "retryable", "riskLevel", "idempotencyKey"], "properties": {
      "contractVersion": { "const": "v1" }, "id": { "type": "string", "minLength": 1, "maxLength": 128 },
      "type": { "type": "string", "enum": ["NAVIGATE", "CLICK", "FILL", "SELECT", "CHECK", "UPLOAD", "KEYBOARD", "WAIT", "SCROLL"] },
      "target": { "$ref": "#/$defs/locator" }, "value": { "type": "string", "maxLength": 10000 },
      "valueRef": { "type": "string", "pattern": "^(credential|dataset|runtime):[A-Za-z0-9._:-]+$", "maxLength": 512 },
      "fileRef": { "type": "string", "pattern": "^(artifact|dataset):[A-Za-z0-9._:-]+$", "maxLength": 512 },
      "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 256 }, "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 60000 },
      "retryable": { "type": "boolean" }, "riskLevel": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] }
    } },
    "assertion": { "type": "object", "additionalProperties": false, "required": ["contractVersion", "type", "timeoutMs"], "properties": {
      "contractVersion": { "const": "v1" }, "type": { "type": "string", "enum": ["TEXT", "VISIBLE", "ENABLED", "CHECKED", "ATTRIBUTE", "COUNT", "URL", "TITLE"] },
      "target": { "$ref": "#/$defs/locator" }, "operator": { "type": "string", "maxLength": 64 }, "expected": { "type": "string", "maxLength": 10000 },
      "attribute": { "type": "string", "maxLength": 256 }, "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 60000 }
    } }
  }
}
