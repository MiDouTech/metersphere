{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": ["cases"],
  "additionalProperties": true,
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 255 },
          "level": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "editType": { "type": "string", "enum": ["STEP", "TEXT"] },
          "moduleId": { "type": ["string", "null"] },
          "templateId": { "type": ["string", "null"] },
          "prerequisite": { "type": ["string", "null"] },
          "textDescription": { "type": ["string", "null"] },
          "expectedResult": { "type": ["string", "null"] },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "num": { "type": ["integer", "null"] },
                "desc": { "type": ["string", "null"] },
                "result": { "type": ["string", "null"] },
                "sourceRef": { "type": ["string", "null"] }
              }
            }
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "sourceReferences": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "documentId": { "type": ["string", "null"] },
                "section": { "type": ["string", "null"] },
                "excerpt": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
