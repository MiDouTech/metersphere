{
  "name": "@metersphere/ai-browser-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MeterSphere AI Web UI execution runner",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
