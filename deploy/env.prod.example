# MeterSphere production runtime env (Solution A: Nacos)
# Copy to server as /opt/metersphere/env.prod and fill in real values.

# ---- Nacos (required) ----
SPRING_PROFILES_ACTIVE=nacos
NACOS_SERVER_ADDR=10.0.1.1:8848
NACOS_NAMESPACE=prod
NACOS_GROUP=METERSPHERE
NACOS_USERNAME=nacos
NACOS_PASSWORD=your-nacos-password

# ---- Image ----
MS_IMAGE=docker.cnb.cool/miduoyanfa/middleground/metersphere/metersphere-backend:latest
MS_CONTAINER_NAME=metersphere

# ---- Host paths (mounted into container) ----
MS_CONF_DIR=/opt/metersphere/conf
MS_LOG_DIR=/opt/metersphere/logs

# ---- Ports ----
MS_HTTP_PORT=8081
MS_TCP_PORT=7071

# ---- WeCom AI Bot Bridge (required when the integration is enabled) ----
# deploy/docker-compose.yml starts the backend and Bridge together. These three
# files are required by the unified deployment and must have mode 600.
MS_WECOM_BRIDGE_TOKEN_FILE=/opt/metersphere/secrets/wecom_bridge_token
MS_WECOM_BRIDGE_CALLBACK_TOKEN_FILE=/opt/metersphere/secrets/wecom_callback_token
MS_WECOM_SECRET_MASTER_KEY_FILE=/opt/metersphere/secrets/wecom_master_key
MS_WECOM_BRIDGE_CPUS=0.25
MS_WECOM_BRIDGE_MEMORY=192m
