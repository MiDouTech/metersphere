# MeterSphere standalone runtime environment.
# The WeCom connector runs inside the MeterSphere container.

SPRING_PROFILES_ACTIVE=local

# ---- Image ----
MS_IMAGE=docker.cnb.cool/miduoyanfa/middleground/metersphere/metersphere-backend:latest
MS_CONTAINER_NAME=metersphere

# ---- Host paths ----
MS_CONF_DIR=/opt/metersphere/conf
MS_LOG_DIR=/opt/metersphere/logs

# ---- Ports ----
MS_HTTP_PORT=8081
MS_TCP_PORT=7071

# ---- MySQL ----
MYSQL_HOST=10.0.1.x
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=10.0.1.x:9092

# ---- MinIO ----
MINIO_ENDPOINT=http://10.0.1.x:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=change-me

# Redis is configured in /opt/metersphere/conf/redisson.yml.
